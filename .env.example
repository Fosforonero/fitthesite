# ─────────────────────────────────────────────────────────
# FitMesh.fit — environment variables template
# Copia in `.env.local` e compila i valori (mai committare .env.local).
# In production, configura le stesse vars in Vercel → Settings → Environment.
# ─────────────────────────────────────────────────────────

# ── Supabase (public — esposti al browser via NEXT_PUBLIC_*) ──
# Trova in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# ── Supabase (server-only — MAI esposti al client) ──
# Service role bypassa la RLS: USA SOLO in Server Actions / API Routes.
# In Vercel: scope SOLO "Production" + "Preview", NON committare.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Device JWT (per ingest sync dall'app mobile) ──
# Random 32 bytes. Genera: `openssl rand -base64 32`
DEVICE_JWT_SECRET=

# ── Deletion cron secret (per pg_cron callback) ──
# Random 32 bytes per autenticare le chiamate da pg_cron all'Edge Function execute-deletion.
DELETION_CRON_SECRET=

# ── App URL ──
# Dev locale: http://localhost:3000
# Production: https://fitmesh.fit
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Firebase / FCM (push notifications — sync-trigger cron + family-events webhook) ──
# JSON completo del service account Firebase (da Firebase Console → Project Settings → Service Accounts).
# Usato sia dal cron /api/cron/sync-trigger (silent push Doze) sia dal webhook /api/v1/family-events/webhook.
# Vercel: aggiungi come Sensitive env var → Production + Preview. MAI committare il valore.
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n","client_email":"firebase-adminsdk-...@....iam.gserviceaccount.com"}

# ── Family Events Webhook Secret (per /api/v1/family-events/webhook) ──
# Random 32 bytes. Genera: `openssl rand -base64 32`
# Stessa stringa va configurata nel Supabase Webhook header X-Webhook-Secret.
FAMILY_EVENTS_WEBHOOK_SECRET=

# ── Email (Phase 8+: switch da Supabase SMTP a Resend per migliore deliverability) ──
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=noreply@fitmesh.fit
