{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "**": false
    }
  },
  "installCommand": "pnpm install --no-frozen-lockfile",
  "crons": [
    {
      "path": "/api/cron/beta-welcome-emails",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/indexnow-daily",
      "schedule": "30 6 * * *"
    }
  ]
}
